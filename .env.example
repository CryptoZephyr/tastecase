# Local Postgres only; never put cloud passwords in this file.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tastecase
HOST=127.0.0.1
PORT=3000
# Required to verify real owner sessions. Use your dedicated Supabase project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Web build-time public settings: publishable/anon only, NEVER service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # alternative to the anon variable
# Optional recorded public sample. All three must be set together after review.
# Only dedicated synthetic inputs with genuine persisted provider evidence qualify.
# TASTECASE_PUBLIC_SAMPLE_PROJECT_ID=
# TASTECASE_PUBLIC_SAMPLE_CASE_ID=
# TASTECASE_PUBLIC_SAMPLE_INPUTS_SYNTHETIC=true
# Hosted Supabase uses sslmode=verify-full in DATABASE_URL. Set this to the
# absolute path to supabase/certs/prod-ca-2021.crt before starting Node.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/supabase/certs/prod-ca-2021.crt
# DATABASE_SSL_CA_FILE=/absolute/path/to/supabase/certs/prod-ca-2021.crt
# Backend discovery only. The mixed-case key name matches the saved secret.
QLOO_API_KEY=
LiteLLM_API_KEY=
# Web server's fixed backend origin; the local runner uses the same setting.
TASTECASE_API_ORIGIN=http://127.0.0.1:3000
# Runner credential and target-provider settings stay on the runner machine.
TASTECASE_RUNNER_TOKEN=
# Optional sample target adapter; not required for deterministic local tests.
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
LITELLM_MODEL=nova-micro
LITELLM_API_KEY=
